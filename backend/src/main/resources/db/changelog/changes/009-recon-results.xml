<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV045 — recon_results table
 WHAT:    Persists each ReconResult produced by ReconciliationEngine so the
          insert-recon-verify integration test can assert against real rows.
 WHY:     Hitting real SQL (not an H2 stand-in) catches column-type
          mismatches an in-memory test would miss.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="009-create-recon-results" author="trainer">
        <createTable tableName="recon_results">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="trade_ref" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="discrepancy_type" type="VARCHAR(30)"/>
            <column name="details" type="VARCHAR(500)"/>
        </createTable>
        <rollback>
            <dropTable tableName="recon_results"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
