<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV009 — JSONB column on instruments (+ GIN index on Postgres)
 WHAT:    instruments.metadata as JSONB (Postgres) / JSON (H2) to hold
          per-asset-class detail (e.g. dividend yield, country, sector).
 HOW:     Two dialect-specific changesets guarded by <dbms>. The entity uses
          Hibernate's @JdbcTypeCode(SqlTypes.JSON), which resolves to jsonb
          on Postgres and H2's native JSON type on dev — both changesets
          must produce a column ddl-auto=validate accepts for that dialect.
 WHY:     Schemaless metadata avoids 12 columns that only apply to one asset
          class. Trade-off: validation moves to the app layer.
 OBSERVE: \d instruments shows metadata jsonb. EXPLAIN ANALYZE on a metadata
          ->> 'sector' lookup hits idx_instruments_metadata_gin.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="003-jsonb-on-instruments" author="trainer">
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="postgresql"/>
                <tableExists tableName="instruments"/>
                <not><columnExists tableName="instruments" columnName="metadata"/></not>
            </and>
        </preConditions>
        <sql>ALTER TABLE instruments ADD COLUMN metadata JSONB DEFAULT '{}'::JSONB NOT NULL;</sql>
        <sql>CREATE INDEX idx_instruments_metadata_gin ON instruments USING GIN (metadata jsonb_path_ops);</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS idx_instruments_metadata_gin;</sql>
            <sql>ALTER TABLE instruments DROP COLUMN metadata;</sql>
        </rollback>
    </changeSet>

    <changeSet id="003-jsonb-on-instruments-h2" author="trainer">
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="h2"/>
                <not><columnExists tableName="instruments" columnName="metadata"/></not>
            </and>
        </preConditions>
        <sql>ALTER TABLE instruments ADD COLUMN metadata JSON DEFAULT '{}' NOT NULL;</sql>
        <rollback>
            <sql>ALTER TABLE instruments DROP COLUMN metadata;</sql>
        </rollback>
    </changeSet>

    <!-- ADV013 — JSONB release boundary -->
    <changeSet id="tag-release-1-1" author="trainer">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM databasechangelog WHERE tag = 'release-1.1'
            </sqlCheck>
        </preConditions>
        <tagDatabase tag="release-1.1"/>
    </changeSet>

</databaseChangeLog>
