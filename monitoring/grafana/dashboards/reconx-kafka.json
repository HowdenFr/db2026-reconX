{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "timeseries",
      "title": "Consumer lag by topic",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_consumer_fetch_manager_records_lag) or label_replace(vector(0), \"topic\", \"trade-events\", \"\", \"\") or label_replace(vector(0), \"topic\", \"system-alerts\", \"\", \"\")",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Throughput: produced vs consumed",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_consumer_fetch_manager_records_consumed_total[1m])) or vector(0)",
          "legendFormat": "consumed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(kafka_producer_record_send_total[1m])) or vector(0)",
          "legendFormat": "produced"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "DLQ message count",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumer_fetch_manager_records_consumed_total{topic=\"trade-events-dlq\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "auto"
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["reconx", "kafka"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "ReconX Kafka Health",
  "uid": "reconx-kafka",
  "version": 1
}
