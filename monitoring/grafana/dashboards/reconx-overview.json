{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "timeseries",
      "title": "API request rate by endpoint (TICKET-ADV087)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "API response time P50/P95/P99 (ADV088)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))",
          "legendFormat": "P50 {{uri}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))",
          "legendFormat": "P95 {{uri}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))",
          "legendFormat": "P99 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Open recon breaks (TICKET-ADV091)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "recon_break_count"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "auto"
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Trades created / sec (ADV089)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(trade_created_total[1m])) or vector(0)",
          "legendFormat": "Trades created /s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "trades/s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Reconciliation runs (last 5m) (ADV090)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(reconciliation_duration_seconds_count[5m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "auto"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "barchart",
      "title": "Trades by status (ADV092)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (trades_by_status) or label_replace(vector(0), \"status\", \"PENDING\", \"\", \"\") or label_replace(vector(0), \"status\", \"MATCHED\", \"\", \"\") or label_replace(vector(0), \"status\", \"UNMATCHED\", \"\", \"\") or label_replace(vector(0), \"status\", \"DISPUTED\", \"\", \"\") or label_replace(vector(0), \"status\", \"CANCELLED\", \"\", \"\")",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "tooltip": {
          "mode": "single"
        },
        "xField": "status"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["reconx"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "ReconX Overview",
  "uid": "reconx-overview",
  "version": 1
}
