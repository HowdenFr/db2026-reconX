{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@services/*": ["src/services/*"],
      "@context/*": ["src/context/*"],
      "@pages/*": ["src/pages/*"]
    }
  },
  "include": ["src", "vite.config.js"]
}
